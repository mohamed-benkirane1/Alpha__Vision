# URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Set to true only in development to show the demo funding button
VITE_ALLOW_DEMO_FUNDING=false

# Stitch MCP design tool API key (only needed if using the Stitch MCP integration)
STITCH_API_KEY=your_stitch_api_key
