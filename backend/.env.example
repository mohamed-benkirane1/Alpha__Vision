# =========================
# Runtime
# =========================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allowed origins for Vercel frontend domains/previews.
FRONTEND_ORIGINS=
# Optional legacy second allowed origin for local/mobile testing.
FRONTEND_URL_ALT=

# =========================
# Database
# =========================
# Local example:  mongodb://localhost:27017/alpha_vision
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=your_mongodb_uri

# =========================
# Auth / JWT
# =========================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never use "secret", "changeme", etc.
JWT_SECRET=your_jwt_secret_minimum_32_characters_replace_this
# Cookie SameSite policy: lax works for localhost/same-site deployments.
# Use none only for HTTPS cross-site frontend/backend deployments and add CSRF protection.
AUTH_COOKIE_SAME_SITE=lax

# =========================
# Market / News
# =========================
MARKET_CACHE_TTL_SECONDS=10
# Get a free key at https://gnews.io
GNEWS_API_KEY=your_gnews_api_key

# =========================
# AI Provider - Groq primary
# =========================
# Primary AI key used by chatbot and AI signals
GROQ_API_KEY=your_groq_api_key

# Legacy/fallback provider support kept for compatibility
# Get a Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=groq
AI_SIGNAL_PROVIDER=groq
AI_SIGNAL_DEFAULT_SYMBOL=BTC

# Alternative provider key. Leave empty to disable.
DEEPSEEK_API_KEY=

# =========================
# Google OAuth
# =========================
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# =========================
# Stripe
# =========================
# Use sk_test_... keys for development, sk_live_... for production
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
# Get from Stripe Dashboard > Webhooks > your endpoint > Signing secret
# Local dev: stripe listen --forward-to localhost:5000/api/payment/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# =========================
# Demo / Paper Trading
# =========================
# Allowed only for demo/soutenance mode.
# In production, ALLOW_DEMO_FUNDING=true logs a warning and should be disabled for real public production.
ALLOW_DEMO_FUNDING=true

# =========================
# Bot
# =========================
BOT_DEFAULT_INTERVAL_SECONDS=60
BOT_MAX_POSITION_SIZE=1000

# =========================
# Password reset email (SMTP)
# =========================
# Any SMTP provider works.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Code uses EMAIL_FROM for the sender address.
EMAIL_FROM=Alpha Vision <no-reply@example.com>
RESET_PASSWORD_EXPIRES_MINUTES=15
# Set to true in development only to return the reset token in the JSON response
ENABLE_DEV_RESET_TOKEN_RESPONSE=false

# =========================
# API rate limits
# =========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_MAX=30
PAYMENT_READ_RATE_LIMIT_MAX=300
CHATBOT_RATE_LIMIT_MAX=30

# =========================
# Portfolio history snapshots
# =========================
PORTFOLIO_SNAPSHOT_MIN_INTERVAL_SECONDS=300
