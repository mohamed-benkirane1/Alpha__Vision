# Runtime
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required backend configuration
MONGO_URI=mongodb://localhost:27017/alpha_vision
# Set a long random value before starting the backend.
JWT_SECRET=

# Market and external providers
MARKET_CACHE_TTL_SECONDS=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep demo funding disabled in production.
ALLOW_DEMO_FUNDING=true
GNEWS_API_KEY=
DEEPSEEK_API_KEY=
AI_SIGNAL_PROVIDER=deepseek
AI_SIGNAL_DEFAULT_SYMBOL=BTC
BOT_DEFAULT_INTERVAL_SECONDS=60
BOT_MAX_POSITION_SIZE=1000

# Password reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESET_PASSWORD_EXPIRES_MINUTES=15
ENABLE_DEV_RESET_TOKEN_RESPONSE=false

# API rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_MAX=30
CHATBOT_RATE_LIMIT_MAX=30

# Portfolio history snapshots
PORTFOLIO_SNAPSHOT_MIN_INTERVAL_SECONDS=300
